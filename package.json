{
  "name": "create-aziz-app",
  "version": "3.4.0",
  "description": "Create Aziz.js apps — lightweight Next.js clone with file-based routing, React hooks, and API routes",
  "keywords": [
    "aziz.js",
    "nextjs",
    "framework",
    "cli",
    "create-app",
    "file-based-routing",
    "react-hooks",
    "api-routes",
    "live-reload",
    "lightweight"
  ],
  "license": "MIT",
  "author": "Syed Muhammad Aziz Ahmed",
  "type": "commonjs",
  "files": [
    "bin",
    "template",
    "SECURITY.md"
  ],
  "bin": {
    "create-aziz-app": "bin/create-aziz-app.js"
  },
  "scripts": {
    "postversion": "git push && git push --tags",
    "dev": "cd template && node scripts/dev-server.js",
    "build": "cd template && node scripts/build.js",
    "start": "cd template && node scripts/dev-server.js --production",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "@babel/standalone": "^7.0.0"
