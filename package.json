    "react",
    "framework",
    "file-based-routing",
    "ssr",
    "isr",
    "api-routes",
    "typescript",
    "no-bundler",
    "zero-dependencies",
    "create-app",
    "cli"
  ],
  "license": "MIT",
  "author": {
    "name": "Syed Muhammad Aziz Ahmed",
    "email": "azizahmed10088@gmail.com",
    "url": "https://github.com/M-Aziz-Ahmed"
  },
  "homepage": "https://github.com/M-Aziz-Ahmed/Aziz.js-Framework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-Aziz-Ahmed/Aziz.js-Framework.git"
  },
  "bugs": {
    "url": "https://github.com/M-Aziz-Ahmed/Aziz.js-Framework/issues"
  },
  "type": "commonjs",
  "files": [
    "bin",
    "template",
    "AUTHORS.md",
    "SECURITY.md"
  ],
  "bin": {
    "create-aziz-app": "bin/create-aziz-app.js"
  },
  "scripts": {
    "postversion": "git push && git push --tags",
    "dev": "cd template && node scripts/dev-server.js",
    "build": "cd template && node scripts/build.js",
    "start": "cd template && node scripts/dev-server.js --production",
    "typecheck": "cd template && node scripts/typecheck.js",
    "test": "node --test \"tests/**/*.test.js\""
